# Navegador: autenticação do Admin e uploads diretos ao Storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor/Vercel: nunca exponha a service role no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: chave publishable moderna usada pela validação server-side.
SUPABASE_PUBLISHABLE_KEY=

# Navegador: autenticação do Admin e uploads diretos ao Storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor/Vercel: nunca exponha a service role no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: chave publishable moderna usada pela validação server-side.
SUPABASE_PUBLISHABLE_KEY=

# KIRO IA / Creator Hub.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
KIRO_AI_MODEL=

# Grok / xAI. A chave permanece apenas no servidor.
XAI_API_KEY=
# Só habilite geração paga depois de autenticação e limites estarem configurados.
CREATOR_HUB_GENERATION_ENABLED=false
# Proteção temporária de teste administrativo. Substituir pela sessão KIRO antes do lançamento público.
CREATOR_HUB_ADMIN_TOKEN=
